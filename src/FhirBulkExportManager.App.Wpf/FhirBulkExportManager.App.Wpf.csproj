    <ProjectReference Include="../FhirBulkExportManager.Persistence.Sqlite/FhirBulkExportManager.Persistence.Sqlite.csproj" />
    <ProjectReference Include="../FhirBulkExportManager.PluginHost/FhirBulkExportManager.PluginHost.csproj" />
    <ProjectReference Include="../FhirBulkExportManager.Worker/FhirBulkExportManager.Worker.csproj" />
    <ProjectReference Include="../../plugins/FhirBulkExportManager.Plugin.EClinicalWorks/FhirBulkExportManager.Plugin.EClinicalWorks.csproj" />
    <ProjectReference Include="../../plugins/FhirBulkExportManager.Plugin.PublicR4/FhirBulkExportManager.Plugin.PublicR4.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
