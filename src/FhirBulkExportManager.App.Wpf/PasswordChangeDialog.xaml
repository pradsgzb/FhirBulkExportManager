<Window x:Class="FhirBulkExportManager.App.Wpf.PasswordChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application password" Height="390" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Protect this application" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="The password is required at startup and again before a remote export can be cancelled. Use 10–256 characters. The password itself is never stored." Margin="0,8,0,14" TextWrapping="Wrap" Foreground="#475467" />
        <StackPanel Grid.Row="2" x:Name="CurrentPasswordPanel">
            <TextBlock Text="Current password" FontWeight="SemiBold" />
            <PasswordBox x:Name="CurrentPasswordBox" Margin="0,4,0,10" Padding="8,6" AutomationProperties.Name="Current application password" />
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="New password" FontWeight="SemiBold" />
            <PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,10" Padding="8,6" AutomationProperties.Name="New application password" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Confirm new password" FontWeight="SemiBold" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,0" Padding="8,6" AutomationProperties.Name="Confirm new application password" />
            <TextBlock x:Name="ValidationText" Foreground="#B42318" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save Password" IsDefault="True" MinWidth="120" Click="Accept_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
