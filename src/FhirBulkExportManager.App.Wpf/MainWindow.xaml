<Window x:Class="FhirBulkExportManager.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise FHIR Bulk Export Manager" Height="820" Width="1440"
        MinHeight="650" MinWidth="1100" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Background="#0F3B4C" Padding="20,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Enterprise FHIR Bulk Export Manager" Foreground="White" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="v1.0.0" Foreground="#CDE7EF" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="12" Background="Transparent">
            <TabItem Header="Dashboard &amp; Jobs">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="6" Margin="0,0,0,10">
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Margin="3" Padding="12">
                            <StackPanel><TextBlock Text="DRAFT" Foreground="#475467" /><TextBlock Text="{Binding DraftCount}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Margin="3" Padding="12">
                            <StackPanel><TextBlock Text="ACTIVE" Foreground="#175CD3" /><TextBlock Text="{Binding ActiveCount}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Margin="3" Padding="12">
                            <StackPanel><TextBlock Text="DOWNLOAD / VALIDATE" Foreground="#0E7090" /><TextBlock Text="{Binding DownloadingCount}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Background="#FFFAEB" BorderBrush="#FEC84B" BorderThickness="1" CornerRadius="4" Margin="3" Padding="12">
                            <StackPanel><TextBlock Text="HELD FOR REVIEW" Foreground="#B54708" /><TextBlock Text="{Binding HeldCount}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Background="#FEF3F2" BorderBrush="#FDA29B" BorderThickness="1" CornerRadius="4" Margin="3" Padding="12">
                            <StackPanel><TextBlock Text="FAILED / UNKNOWN" Foreground="#B42318" /><TextBlock Text="{Binding FailedCount}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Background="#ECFDF3" BorderBrush="#6CE9A6" BorderThickness="1" CornerRadius="4" Margin="3" Padding="12">
                            <StackPanel><TextBlock Text="COMPLETED" Foreground="#027A48" /><TextBlock Text="{Binding CompletedCount}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                    </UniformGrid>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh Now" Command="{Binding RefreshCommand}" MinWidth="105" AutomationProperties.Name="Refresh jobs now" />
                        <Border DockPanel.Dock="Right" Background="#EFF8FF" BorderBrush="#84CAFF" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="3">
                            <TextBlock Text="{Binding AutoRefreshCountdownText}" Foreground="#175CD3" FontWeight="SemiBold" MinWidth="125" TextAlignment="Center" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                            <CheckBox Content="Auto refresh" IsChecked="{Binding AutoRefreshEnabled}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <Slider Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding AutoRefreshIntervalSeconds}" Width="125" VerticalAlignment="Center" AutomationProperties.Name="Auto refresh interval in seconds" />
                            <TextBlock Text="{Binding AutoRefreshIntervalText}" VerticalAlignment="Center" MinWidth="78" Margin="6,0,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" MinWidth="90" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="360" ToolTip="Search by job name, job ID, or Group ID" AutomationProperties.Name="Search export jobs" />
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*" MinHeight="120" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="7*" MinHeight="200" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Export jobs">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="125" />
                                <DataGridTextColumn Header="Job Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Export" Binding="{Binding ExportType}" Width="90" />
                                <DataGridTextColumn Header="Group / Scope" Binding="{Binding GroupId}" Width="150" />
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc, Converter={StaticResource DateTimeDisplayConverter}}" Width="170" />
                                <DataGridTextColumn Header="Next Check" Binding="{Binding NextPollAtUtc, Converter={StaticResource DateTimeDisplayConverter}}" Width="170" />
                                <DataGridTextColumn Header="Progress (X-Progress)" Binding="{Binding ProgressText}" Width="220" />
                                <DataGridTemplateColumn Header="Downloaded / Total" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource FileCountProgressConverter}">
                                                        <Binding Path="DownloadedFileCount" />
                                                        <Binding Path="OutputFileCount" />
                                                        <Binding Path="DeletedFileCount" />
                                                        <Binding Path="ErrorFileCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Plugin" Binding="{Binding PluginId}" Width="120" />
                                <DataGridTextColumn Header="Version" Binding="{Binding PluginVersion}" Width="70" />
                                <DataGridTextColumn Header="Last Error" Binding="{Binding LastErrorMessage}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#D0D5DD" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize job details" />

                        <Border Grid.Row="2" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="2,0,2,10">
                                    <Border DockPanel.Dock="Right" Background="#ECFDF3" BorderBrush="#6CE9A6" BorderThickness="1" CornerRadius="4" Padding="12,7" MaxWidth="500">
                                        <StackPanel>
                                            <TextBlock Text="LATEST SERVER STATUS (X-PROGRESS)" Foreground="#027A48" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedJob.ProgressText, TargetNullValue='No X-Progress received yet'}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedJob.Name, TargetNullValue='Select a job'}" FontSize="19" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedJob.State}" Foreground="#175CD3" FontWeight="SemiBold" />
                                            <TextBlock Text="  ·  " Foreground="#98A2B3" />
                                            <TextBlock Text="{Binding SelectedJob.Id}" Foreground="#475467" FontFamily="Consolas" />
                                            <TextBlock Text="  ·  " Foreground="#98A2B3" />
                                            <TextBlock Text="{Binding JobDetailStatus}" Foreground="#475467" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,10">
                                    <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8">
                                        <StackPanel><TextBlock Text="FILES DOWNLOADED" Foreground="#667085" FontSize="10" /><TextBlock Text="{Binding JobDashboard.FileCompletionText}" FontSize="17" FontWeight="SemiBold" /><ProgressBar Value="{Binding JobDashboard.FileCompletionPercent}" Maximum="100" Height="5" Margin="0,5,0,0" /></StackPanel>
                                    </Border>
                                    <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8">
                                        <StackPanel><TextBlock Text="DATA DOWNLOADED" Foreground="#667085" FontSize="10" /><TextBlock Text="{Binding JobDashboard.DataDownloadedText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                    </Border>
                                    <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8">
                                        <StackPanel><TextBlock Text="EXPORT SPEED (EST.)" Foreground="#667085" FontSize="10" /><TextBlock Text="{Binding JobDashboard.AverageExportSpeedText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                    </Border>
                                    <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8">
                                        <StackPanel><TextBlock Text="DOWNLOAD SPEED" Foreground="#667085" FontSize="10" /><TextBlock Text="{Binding JobDashboard.AverageDownloadSpeedText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                    </Border>
                                    <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8">
                                        <StackPanel><TextBlock Text="ESTIMATED REMAINING" Foreground="#667085" FontSize="10" /><TextBlock Text="{Binding JobDashboard.EstimatedCompletionText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                    </Border>
                                    <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8">
                                        <StackPanel><TextBlock Text="ELAPSED / NEXT CHECK" Foreground="#667085" FontSize="10" /><TextBlock Text="{Binding JobDashboard.ElapsedText}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding JobDashboard.NextCheckText}" FontSize="11" Foreground="#475467" TextWrapping="Wrap" /></StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="11*" MinWidth="500" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="9*" MinWidth="420" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Status history" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,6" />
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedJobHistory}" SelectedItem="{Binding SelectedStatusHistory}" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Job status history">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, Converter={StaticResource DateTimeDisplayConverter}}" Width="170" />
                                                <DataGridTextColumn Header="State" Binding="{Binding StateChange}" Width="180" />
                                                <DataGridTextColumn Header="X-Progress" Binding="{Binding Progress}" Width="210" />
                                                <DataGridTextColumn Header="HTTP" Binding="{Binding RequestCount}" Width="50" />
                                                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="170" />
                                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>

                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#EAECF0" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize HTTP inspector" />

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="2,0,0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="Secrets redacted" Foreground="#B54708" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="Preserved HTTP exchange" FontSize="15" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ComboBox Grid.Row="1" ItemsSource="{Binding SelectedHttpExchanges}" SelectedItem="{Binding SelectedHttpExchange}" DisplayMemberPath="Summary" AutomationProperties.Name="HTTP exchange" />
                                        <StackPanel Grid.Row="2" Margin="4,2,4,5">
                                            <TextBlock Text="{Binding SelectedHttpExchange.RequestLine}" FontFamily="Consolas" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedHttpExchange.ResponseStatus}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedHttpExchange.Timing}" Foreground="#667085" />
                                            <TextBlock Text="{Binding SelectedHttpExchange.Failure}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,5,0,0">
                                                <Button Content="Copy Request" Command="{Binding CopyHttpRequestCommand}" MinWidth="100" AutomationProperties.Name="Copy complete HTTP request" />
                                                <Button Content="Copy Response" Command="{Binding CopyHttpResponseCommand}" MinWidth="105" AutomationProperties.Name="Copy complete HTTP response" />
                                                <Button Content="Copy Request + Response" Command="{Binding CopyHttpExchangeCommand}" MinWidth="165" AutomationProperties.Name="Copy complete HTTP exchange" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <TabControl Grid.Row="3">
                                            <TabItem Header="Headers">
                                                <Grid Margin="7">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Request headers" FontWeight="SemiBold" />
                                                    <TextBox Grid.Row="1" Text="{Binding SelectedHttpExchange.RequestHeadersText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                                    <TextBlock Grid.Row="2" Text="Response headers" FontWeight="SemiBold" Margin="0,6,0,0" />
                                                    <TextBox Grid.Row="3" Text="{Binding SelectedHttpExchange.ResponseHeadersText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                                </Grid>
                                            </TabItem>
                                            <TabItem Header="Request Body">
                                                <TextBox Text="{Binding SelectedHttpExchange.RequestBodyText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="7" />
                                            </TabItem>
                                            <TabItem Header="Response Body">
                                                <TextBox Text="{Binding SelectedHttpExchange.ResponseBodyText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="7" />
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="Start Export" Command="{Binding StartCommand}" />
                        <Button Content="Get Status Now" Command="{Binding StatusNowCommand}" />
                        <Button Content="Pause Local Processing" Command="{Binding PauseCommand}" />
                        <Button Content="Resume Local Processing" Command="{Binding ResumeCommand}" />
                        <Button Content="Cancel Remote Export" Foreground="{StaticResource DangerBrush}" Command="{Binding CancelRemoteCommand}" />
                        <Button Content="Approve Partial Export" Command="{Binding ApprovePartialCommand}" />
                        <Button Content="Cleanup Remote Export" Foreground="{StaticResource DangerBrush}" Command="{Binding CleanupRemoteCommand}" />
                        <Button Content="Open Full Details" Command="{Binding DetailsCommand}" />
                        <Button Content="Open Export Folder" Command="{Binding OpenFolderCommand}" />
                        <Button Content="Archive" Command="{Binding ArchiveCommand}" />
                        <Button Content="Delete Local Job" Foreground="{StaticResource DangerBrush}" Command="{Binding DeleteLocalCommand}" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Add New Export Job">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24" MaxWidth="920" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="620" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="Create Draft Export Job" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Saving this form creates a local Draft only. It never calls $export. Select Start Export from the Jobs screen when ready." Foreground="#475467" TextWrapping="Wrap" Margin="0,0,0,18" />
                        <TextBlock Grid.Row="2" Text="Friendly job name *" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewJobName}" />
                        <TextBlock Grid.Row="3" Text="Description / notes" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewJobDescription}" AcceptsReturn="True" Height="62" />
                        <TextBlock Grid.Row="4" Text="Vendor *" VerticalAlignment="Center" /><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}" DisplayMemberPath="Name" />
                        <TextBlock Grid.Row="5" Text="Site *" VerticalAlignment="Center" /><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}" DisplayMemberPath="Name" />
                        <TextBlock Grid.Row="6" Text="Credential profile *" VerticalAlignment="Center" /><ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedCredential}" DisplayMemberPath="Name" />
                        <TextBlock Grid.Row="7" Text="Export type *" VerticalAlignment="Center" /><ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding ExportTypes}" SelectedItem="{Binding NewExportType}" />
                        <TextBlock Grid.Row="8" Text="Group ID (Group export)" VerticalAlignment="Center" /><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding NewGroupId}" />
                        <TextBlock Grid.Row="9" Text="_since (ISO timestamp)" VerticalAlignment="Center" /><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding NewSinceUtc}" />
                        <TextBlock Grid.Row="10" Text="_type (comma-separated)" VerticalAlignment="Center" /><TextBox Grid.Row="10" Grid.Column="1" Text="{Binding NewResourceTypes}" />
                        <TextBlock Grid.Row="11" Text="_typeFilter (semicolon-separated)" VerticalAlignment="Center" /><TextBox Grid.Row="11" Grid.Column="1" Text="{Binding NewTypeFilters}" />
                        <TextBlock Grid.Row="12" Text="Priority" VerticalAlignment="Center" /><ComboBox Grid.Row="12" Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewPriority}" />
                        <StackPanel Grid.Row="13" Grid.Column="1" Margin="3,10">
                            <CheckBox Content="Automatically clean up remote export only after valid local commit" IsChecked="{Binding NewAutomaticCleanup}" Margin="0,0,0,10" />
                            <Button Content="Save as Draft" Command="{Binding CreateJobCommand}" HorizontalAlignment="Left" MinWidth="150" Background="{StaticResource PrimaryBrush}" Foreground="White" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Import Existing Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24" MaxWidth="980" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="680" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="Import an Already-Started Export" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#EFF8FF" BorderBrush="#84CAFF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,18">
                            <TextBlock Text="Use this when $export was already started outside this application. Import obtains a fresh token and then queues a GET to the exact Content-Location; it never sends another kickoff request. Requests made earlier in Postman cannot be reconstructed, but every request and response made by this application after import is preserved with secrets redacted." Foreground="#175CD3" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Grid.Row="2" Text="Friendly job name *" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ImportJobName}" />
                        <TextBlock Grid.Row="3" Text="Description / notes" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ImportJobDescription}" AcceptsReturn="True" Height="62" />
                        <TextBlock Grid.Row="4" Text="Exact Content-Location *" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ImportContentLocation}" Height="62" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Exact Content-Location" />
                        <TextBlock Grid.Row="5" Text="Remote start time (UTC, optional)" VerticalAlignment="Center" /><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ImportRemoteStartedUtc}" ToolTip="Example: 2026-09-03T12:30:00Z" />
                        <TextBlock Grid.Row="6" Text="Vendor *" VerticalAlignment="Center" /><ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedImportVendor}" DisplayMemberPath="Name" />
                        <TextBlock Grid.Row="7" Text="Site *" VerticalAlignment="Center" /><ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedImportSite}" DisplayMemberPath="Name" />
                        <TextBlock Grid.Row="8" Text="Credential profile (from site)" VerticalAlignment="Center" /><ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedImportCredential}" DisplayMemberPath="Name" IsEnabled="False" ToolTip="Imported exports always use the credential assigned to the selected site connection." />
                        <TextBlock Grid.Row="9" Text="Export type *" VerticalAlignment="Center" /><ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding ExportTypes}" SelectedItem="{Binding ImportExportType}" />
                        <TextBlock Grid.Row="10" Text="Group ID (Group export)" VerticalAlignment="Center" /><TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ImportGroupId}" />
                        <TextBlock Grid.Row="11" Text="_since (ISO timestamp)" VerticalAlignment="Center" /><TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ImportSinceUtc}" />
                        <TextBlock Grid.Row="12" Text="_type (comma-separated)" VerticalAlignment="Center" /><TextBox Grid.Row="12" Grid.Column="1" Text="{Binding ImportResourceTypes}" />
                        <TextBlock Grid.Row="13" Text="_typeFilter (semicolon-separated)" VerticalAlignment="Center" /><TextBox Grid.Row="13" Grid.Column="1" Text="{Binding ImportTypeFilters}" />
                        <TextBlock Grid.Row="14" Text="Vendor options JSON" VerticalAlignment="Top" Margin="0,8" /><TextBox Grid.Row="14" Grid.Column="1" Text="{Binding ImportVendorOptionsJson}" AcceptsReturn="True" FontFamily="Consolas" Height="72" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Grid.Row="15" Text="Priority" VerticalAlignment="Center" /><ComboBox Grid.Row="15" Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding ImportPriority}" />
                        <StackPanel Grid.Row="16" Grid.Column="1" Margin="3,10">
                            <CheckBox Content="Automatically clean up remote export only after valid local commit" IsChecked="{Binding ImportAutomaticCleanup}" Margin="0,0,0,10" />
                            <Button Content="Import and Start Monitoring" Command="{Binding ImportExistingCommand}" HorizontalAlignment="Left" MinWidth="210" Background="{StaticResource PrimaryBrush}" Foreground="White" AutomationProperties.Name="Import existing export and start monitoring" />
                            <Button Content="Repair Selected Imported Job with This Connection" Command="{Binding RepairImportedConnectionCommand}" HorizontalAlignment="Left" MinWidth="310" Margin="0,10,0,0" ToolTip="Select the affected job on Dashboard &amp; Jobs, choose the correct vendor and site above, then use this action. Content-Location and history are retained; no new export is started." AutomationProperties.Name="Repair selected imported job connection" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Connections">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24" MaxWidth="980" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="650" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="Connection Management" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="The built-in HAPI and SMART public test servers use anonymous access; leave all OAuth fields blank. Never send PHI, confidential, or production data to a public test server. For eClinicalWorks, HealthWizz assertion authentication does not require a client secret. Test Connection calls /metadata only and never starts an export." TextWrapping="Wrap" Foreground="#B42318" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <TextBlock Text="Existing connections" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedConnectionSite}" Height="150" SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Existing connections">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Connection name" Binding="{Binding Name}" Width="260" />
                                    <DataGridTextColumn Header="FHIR base URL" Binding="{Binding FhirBaseUrl}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,14">
                            <WrapPanel>
                                <Button Content="Edit Selected" Command="{Binding EditConnectionCommand}" MinWidth="120" />
                                <Button Content="Delete Selected" Command="{Binding DeleteConnectionCommand}" Foreground="{StaticResource DangerBrush}" MinWidth="120" />
                                <Button Content="Test Selected (/metadata only)" Command="{Binding TestConnectionCommand}" MinWidth="200" />
                                <Button Content="New / Clear Form" Command="{Binding NewConnectionCommand}" MinWidth="130" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ConnectionMetadataStatus}" TextWrapping="Wrap" Foreground="#475467" Margin="4,6,0,2" />
                            <WrapPanel>
                                <Button Content="Copy Saved Metadata JSON" Command="{Binding CopyConnectionMetadataCommand}" MinWidth="180" AutomationProperties.Name="Copy saved CapabilityStatement JSON" />
                                <Button Content="Copy Metadata HTTP History" Command="{Binding CopyConnectionMetadataHttpCommand}" MinWidth="190" AutomationProperties.Name="Copy metadata HTTP history" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <Separator />
                            <TextBlock Text="{Binding ConnectionEditorTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Vendor *" VerticalAlignment="Center" /><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedConnectionVendor}" DisplayMemberPath="Name" IsEnabled="{Binding CanChangeConnectionVendor}" />
                        <TextBlock Grid.Row="6" Text="Site name *" VerticalAlignment="Center" /><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ConnectionSiteName}" />
                        <TextBlock Grid.Row="7" Text="FHIR base URL (HTTPS) *" VerticalAlignment="Center" /><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ConnectionFhirBaseUrl}" />
                        <TextBlock Grid.Row="8" Text="OAuth client ID (authenticated vendors)" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ConnectionClientId}" />
                        <TextBlock Grid.Row="9" Text="OAuth client secret (direct OAuth only)" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,8" />
                        <StackPanel Grid.Row="9" Grid.Column="1">
                            <PasswordBox x:Name="ClientSecretBox" PasswordChanged="ClientSecret_PasswordChanged" AutomationProperties.Name="OAuth client secret (optional)" Margin="3" Padding="7,5" />
                            <TextBlock Text="When editing, leave blank to retain the protected secret." Foreground="#667085" FontSize="11" Margin="4,0,0,2" />
                            <CheckBox Content="Remove the currently stored client secret when saving" IsChecked="{Binding ConnectionRemoveStoredSecret}" Margin="4,2,0,5" />
                        </StackPanel>
                        <TextBlock Grid.Row="10" Text="OAuth token endpoint (from /metadata; editable fallback)" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ConnectionTokenEndpoint}" />
                        <TextBlock Grid.Row="11" Text="HealthWizz assertion endpoint" VerticalAlignment="Center" /><TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ConnectionAssertionEndpoint}" />
                        <TextBlock Grid.Row="12" Text="Scope" VerticalAlignment="Center" /><TextBox Grid.Row="12" Grid.Column="1" Text="{Binding ConnectionScope}" />
                        <TextBlock Grid.Row="13" Text="Assertion audience (defaults to token endpoint)" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBox Grid.Row="13" Grid.Column="1" Text="{Binding ConnectionAudience}" />
                        <TextBlock Grid.Row="14" Text="Advanced auth overrides JSON (optional)" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,8" /><TextBox Grid.Row="14" Grid.Column="1" Text="{Binding ConnectionAuthConfigurationJson}" AcceptsReturn="True" FontFamily="Consolas" Height="110" VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Grid.Row="15" Grid.Column="1" Margin="0,8,0,0">
                            <Button Content="{Binding ConnectionSaveButtonText}" Command="{Binding SaveConnectionCommand}" HorizontalAlignment="Left" MinWidth="190" Background="{StaticResource PrimaryBrush}" Foreground="White" />
                            <Button Content="Cancel Edit / Clear" Command="{Binding NewConnectionCommand}" MinWidth="140" />
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Options">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,12">
                        <Button DockPanel.Dock="Right" Content="Restore Defaults" Command="{Binding RestoreDefaultOptionsCommand}" MinWidth="125" />
                        <StackPanel>
                            <TextBlock Text="Options" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a category. Editable options are saved automatically for this Windows installation." Foreground="#475467" />
                        </StackPanel>
                    </DockPanel>

                    <TabControl Grid.Row="1" TabStripPlacement="Left" Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="MinWidth" Value="190" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="14,10" />
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="General">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">
                                    <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" />
                                    <Separator Margin="0,8,0,18" />
                                    <TextBlock Text="Window behavior" FontSize="16" FontWeight="SemiBold" />
                                    <CheckBox Content="Minimize to the system tray and continue local processing" IsChecked="{Binding MinimizeToTray}" Margin="0,12,0,4" />
                                    <TextBlock Text="When enabled, minimizing hides the main window while background monitoring and downloads continue." Foreground="#667085" TextWrapping="Wrap" Margin="22,0,0,16" />
                                    <Border Background="#EFF8FF" BorderBrush="#84CAFF" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,14,0,0">
                                        <TextBlock Text="Auto refresh only reloads the local dashboard. It never forces an early FHIR status poll, starts an export, or changes a remote job." TextWrapping="Wrap" Foreground="#175CD3" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Date &amp; Time">
                            <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Text="Date &amp; Time" FontSize="22" FontWeight="SemiBold" />
                                <Separator Margin="0,8,0,18" />
                                <TextBlock Text="Display all dates and times as" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding DateDisplayModes}" SelectedItem="{Binding SelectedDateDisplayMode}" Width="260" HorizontalAlignment="Left" Margin="0,10,0,6" />
                                <TextBlock Text="{Binding DateDisplayDescription}" Foreground="#475467" TextWrapping="Wrap" />
                                <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,20,0,0">
                                    <TextBlock Text="Durable timestamps continue to be stored in UTC. This option changes presentation only, including job grids, history, metadata history, and HTTP exchange timing." TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Auto Refresh">
                            <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Text="Auto Refresh" FontSize="22" FontWeight="SemiBold" />
                                <Separator Margin="0,8,0,18" />
                                <CheckBox Content="Automatically refresh the dashboard" IsChecked="{Binding AutoRefreshEnabled}" FontSize="15" />
                                <TextBlock Text="Refresh interval" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Slider Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding AutoRefreshIntervalSeconds}" Width="390" AutomationProperties.Name="Auto refresh interval in seconds" />
                                    <TextBlock Text="{Binding AutoRefreshIntervalText}" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="#ECFDF3" BorderBrush="#6CE9A6" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,20,0,0" Width="300" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AutoRefreshCountdownText}" Foreground="#027A48" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                                </Border>
                                <TextBlock Text="Range: 5–300 seconds. The countdown is also displayed beside Refresh Now on the Dashboard &amp; Jobs tab." Foreground="#667085" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Security">
                            <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Text="Security" FontSize="22" FontWeight="SemiBold" />
                                <Separator Margin="0,8,0,18" />
                                <TextBlock Text="Application password" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PasswordStatus}" FontSize="15" Margin="0,8,0,12" />
                                <WrapPanel>
                                    <Button Content="Set / Change Password" Command="{Binding ChangePasswordCommand}" MinWidth="165" />
                                    <Button Content="Remove Password" Command="{Binding RemovePasswordCommand}" MinWidth="140" Foreground="{StaticResource DangerBrush}" />
                                </WrapPanel>
                                <TextBlock Text="If a password is configured, the current password is required to change or remove it. Remote export cancellation also asks for the password before the typed CANCEL confirmation." TextWrapping="Wrap" Foreground="#475467" Margin="0,12,0,0" />
                                <Border Background="#FFFAEB" BorderBrush="#FEC84B" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Password recovery" FontWeight="SemiBold" Foreground="#B54708" />
                                        <TextBlock Text="If the password is lost, close the app and start FhirBulkExportManager.App.Wpf.exe --reset-password. This removes application password protection and writes an audit entry; it does not delete jobs, connections, or protected OAuth secrets." TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Network Alerts">
                            <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Text="Network Alerts" FontSize="22" FontWeight="SemiBold" />
                                <Separator Margin="0,8,0,18" />
                                <CheckBox Content="Show an auto-closing network/VPN hint after HTTP 400 from metadata or OAuth token requests" IsChecked="{Binding ShowNetworkAccessHintOnBadRequest}" FontSize="15" />
                                <TextBlock Text="The hint suggests checking VPN, source-IP whitelist, endpoint, scope, and audience. The complete sanitized HTTP request and response remain available in history." TextWrapping="Wrap" Foreground="#475467" Margin="22,10,0,0" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Runtime &amp; Storage">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="28" MaxWidth="850" HorizontalAlignment="Left">
                                    <TextBlock Text="Runtime &amp; Storage" FontSize="22" FontWeight="SemiBold" />
                                    <Separator Margin="0,8,0,18" />
                                    <TextBlock Text="Deployment-controlled values" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="450" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Configured export worker limit" /><TextBlock Grid.Column="1" Text="{Binding ConfiguredExportLimit}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="Detected logical processors" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetectedLogicalProcessors}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Text="Effective export worker limit" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EffectiveExportLimit}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="3" Text="Per-site file download limit" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PerSiteDownloadLimit}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="4" Text="Minimum free disk reserve (GB)" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MinimumFreeDiskSpaceGB}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="5" Text="Managed data root" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DataRoot}" TextWrapping="Wrap" FontFamily="Consolas" />
                                    </Grid>
                                    <Border Background="#FFFAEB" BorderBrush="#FEC84B" BorderThickness="1" Padding="14" Margin="0,24,0,0">
                                        <TextBlock TextWrapping="Wrap">TLS certificate validation is always enabled. There is no “ignore SSL errors” option. Draft jobs never start automatically, and automatic cleanup is blocked unless the durable local commit is re-verified.</TextBlock>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <TextBlock Grid.Row="2" Text="{Binding SettingsStatus}" Foreground="#475467" Margin="4,10,0,0" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#EAECF0" Padding="12,4">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
