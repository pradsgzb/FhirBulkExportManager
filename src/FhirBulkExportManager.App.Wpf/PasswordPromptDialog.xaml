<Window x:Class="FhirBulkExportManager.App.Wpf.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application password" Height="245" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" x:Name="MessageText" Margin="0,10,0,10" TextWrapping="Wrap" Foreground="#475467" />
        <PasswordBox Grid.Row="2" x:Name="PasswordBox" Padding="8,6" AutomationProperties.Name="Application password" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Unlock" IsDefault="True" MinWidth="90" Click="Accept_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
