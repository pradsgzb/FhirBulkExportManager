<Window x:Class="FhirBulkExportManager.App.Wpf.JobDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Job Details" Height="760" Width="1180" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="4,0,4,12">
            <TextBlock Text="{Binding Job.Name}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Job.Id}" Foreground="#475467" FontFamily="Consolas" />
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Border Background="#ECFDF3" BorderBrush="#6CE9A6" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="LATEST SERVER STATUS (X-PROGRESS)" Foreground="#027A48" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Dashboard.LatestServerProgress}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3">
                            <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="14">
                                <StackPanel><TextBlock Text="FILES DOWNLOADED" Foreground="#667085" /><TextBlock Text="{Binding Dashboard.FileCompletionText}" FontSize="23" FontWeight="SemiBold" /><ProgressBar Value="{Binding Dashboard.FileCompletionPercent}" Maximum="100" Height="7" Margin="0,8,0,0" /></StackPanel>
                            </Border>
                            <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="14">
                                <StackPanel><TextBlock Text="DATA DOWNLOADED" Foreground="#667085" /><TextBlock Text="{Binding Dashboard.DataDownloadedText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="14">
                                <StackPanel><TextBlock Text="DOWNLOAD SPEED" Foreground="#667085" /><TextBlock Text="{Binding Dashboard.AverageDownloadSpeedText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="14">
                                <StackPanel><TextBlock Text="EXPORT SPEED (ESTIMATE)" Foreground="#667085" /><TextBlock Text="{Binding Dashboard.AverageExportSpeedText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="14">
                                <StackPanel><TextBlock Text="ESTIMATED REMAINING" Foreground="#667085" /><TextBlock Text="{Binding Dashboard.EstimatedCompletionText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="4" Margin="4" Padding="14">
                                <StackPanel><TextBlock Text="ELAPSED / NEXT CHECK" Foreground="#667085" /><TextBlock Text="{Binding Dashboard.ElapsedText}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Dashboard.NextCheckText}" Foreground="#475467" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="Speed and remaining-time values are estimates derived from preserved X-Progress samples and completed file transfers. Vendor-reported X-Progress remains authoritative." Foreground="#667085" FontStyle="Italic" TextWrapping="Wrap" Margin="4,14,4,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Overview">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Current state" /><TextBlock Grid.Column="1" Text="{Binding Job.State}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Export type" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Job.ExportType}" />
                    <TextBlock Grid.Row="2" Text="Group ID" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Job.GroupId}" />
                    <TextBlock Grid.Row="3" Text="Created" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Job.CreatedAtUtc, Converter={StaticResource DateTimeDisplayConverter}}" />
                    <TextBlock Grid.Row="4" Text="Started" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Job.StartedAtUtc, Converter={StaticResource DateTimeDisplayConverter}}" />
                    <TextBlock Grid.Row="5" Text="Last status" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Job.LastPolledAtUtc, Converter={StaticResource DateTimeDisplayConverter}}" />
                    <TextBlock Grid.Row="6" Text="Next status" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Job.NextPollAtUtc, Converter={StaticResource DateTimeDisplayConverter}}" />
                    <TextBlock Grid.Row="7" Text="Downloaded / total files" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Dashboard.FileCompletionText}" />
                    <TextBlock Grid.Row="8" Text="Progress" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Job.ProgressText}" />
                    <TextBlock Grid.Row="9" Text="Last error" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Job.LastErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                </Grid>
            </TabItem>
            <TabItem Header="Timeline">
                <DataGrid ItemsSource="{Binding Timeline}" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, Converter={StaticResource DateTimeDisplayConverter}}" Width="170" />
                        <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="180" />
                        <DataGridTextColumn Header="From" Binding="{Binding PreviousState}" Width="120" />
                        <DataGridTextColumn Header="To" Binding="{Binding NewState}" Width="120" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Remote Status">
                <StackPanel Margin="18"><TextBlock Text="Exact opaque Content-Location" FontWeight="SemiBold" /><TextBox Text="{Binding Job.RemoteStatusUrl}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,8,0,18" /><TextBlock Text="Remote cleanup verified" FontWeight="SemiBold" /><TextBlock Text="{Binding Job.RemoteCleanupVerified}" /></StackPanel>
            </TabItem>
            <TabItem Header="Manifest">
                <TextBox Text="{Binding ManifestText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="8" />
            </TabItem>
            <TabItem Header="Files">
                <DataGrid ItemsSource="{Binding Files}" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80" />
                        <DataGridTextColumn Header="Resource Type" Binding="{Binding ResourceType}" Width="130" />
                        <DataGridTextColumn Header="File" Binding="{Binding SafeLocalFileName}" Width="210" />
                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="95" />
                        <DataGridTextColumn Header="Bytes" Binding="{Binding ActualBytes, StringFormat={}{0:N0}}" Width="100" />
                        <DataGridTextColumn Header="Records" Binding="{Binding RecordCount, StringFormat={}{0:N0}}" Width="90" />
                        <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*" />
                        <DataGridTextColumn Header="Attempts" Binding="{Binding AttemptCount}" Width="70" />
                        <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Errors">
                <DataGrid ItemsSource="{Binding ErrorFiles}" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Resource" Binding="{Binding ResourceType}" Width="140" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Outcome summary" Binding="{Binding ValidationSummaryJson}" Width="*" />
                        <DataGridCheckBoxColumn Header="Serious" Binding="{Binding HasSeriousOperationOutcome}" Width="75" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Audit">
                <TextBlock Margin="18" Text="The immutable Timeline contains the job-scoped audit trail. Global operator audit events remain in the SQLite AuditEvents table." TextWrapping="Wrap" />
            </TabItem>
            <TabItem Header="Diagnostics">
                <TextBox Text="{Binding DiagnosticsText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="8" />
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="90" />
    </Grid>
</Window>
