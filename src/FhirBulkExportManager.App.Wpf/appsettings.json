{
  "Persistence": {
    "DatabasePath": "%LOCALAPPDATA%\\FhirBulkExportManager\\State\\exports.db",
    "BusyTimeoutSeconds": 30
  },
  "Processing": {
    "MaxConcurrentExports": 4,
    "PerSiteFileDownloadLimit": 4,
    "AutomaticPollingEnabled": true,
    "DefaultPollingBackoffSeconds": 30,
    "MaximumPollingIntervalSeconds": 3600,
    "LeaseDurationSeconds": 120,
    "SchedulerWakeIntervalSeconds": 5
  },
  "Http": {
    "ConnectionTimeoutSeconds": 30,
    "RequestTimeoutSeconds": 120,
    "RetryCount": 4,
    "CircuitBreakSeconds": 60
  },
  "Storage": {
    "DataRoot": "%LOCALAPPDATA%\\FhirBulkExportManager\\Data",
    "MinimumFreeDiskSpaceGB": 10
  },
  "Plugins": {
    "Directory": "Plugins",
    "AllowUnsignedPlugins": false,
    "TrustedAssemblySha256": []
  }
}

