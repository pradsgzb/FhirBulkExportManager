<Window x:Class="FhirBulkExportManager.App.Wpf.TransientNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FHIR connection notice" Height="210" Width="510"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <Border Background="#FFFAEB" BorderBrush="#F79009" BorderThickness="2" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Network access may be required" FontSize="18" FontWeight="SemiBold" Foreground="#B54708" />
            <TextBlock Grid.Row="1" x:Name="MessageText" Margin="0,10,0,8" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="This notice closes automatically." Foreground="#667085" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Close" MinWidth="76" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
